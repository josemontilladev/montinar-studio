{
  "name": "metricaseo-studio",
  "version": "2.2.4",
  "private": true,
  "type": "module",
  "description": "Editor de vídeo y estudio de diseño de MétricaSEO",
  "scripts": {
    "dev": "tsx servidor/index.ts",
    "start": "tsx servidor/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "app": "npm run build:server && electron .",
    "build:server": "esbuild servidor/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.mjs",
    "dist": "npm run chrome && npm run build:server && electron-builder --win nsis --publish never",
    "chrome": "node herramientas/preparar-chrome.mjs",
    "release": "node herramientas/publicar.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@remotion/bundler": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "@remotion/media-utils": "4.0.543",
    "@remotion/paths": "4.0.543",
    "@remotion/player": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "daisyui": "^5.8.1",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.55.0",
    "puppeteer-core": "^25.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.543",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.4",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true,
    "electron": true,
    "electron-winstaller": true
  },
  "productName": "MetricaSEO Studio",
  "author": {
    "name": "MétricaSEO",
    "url": "https://metricaseo.site"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "site.metricaseo.studio",
    "productName": "MetricaSEO Studio",
    "copyright": "MétricaSEO",
    "directories": {
      "output": "C:/Users/KronnicxZ/Instaladores/MetricaSEO Studio",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "electron/**",
      "dist-server/**",
      "servidor/**",
      "app/**",
      "contrato/**",
      "herramientas/**",
      "recursos/**",
      "marcas/**",
      "build/icon.*",
      "LEEME.md",
      "LICENCIAS-FUENTES.md",
      "LICENCIAS-MUSICA-Y-MODELOS.md",
      "editor.config.json",
      "package.json",
      "node_modules/**",
      "!node_modules/.remotion/**",
      "!node_modules/.vite/**",
      "!**/*.map",
      "!.cache/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "MetricaSEO Studio",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MétricaSEO Studio",
      "artifactName": "MetricaSEO-Studio-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "MétricaSEO Studio",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "generic",
      "url": "http://127.0.0.1/metricaseo-studio/"
    }
  },
  "homepage": "https://metricaseo.site"
}
